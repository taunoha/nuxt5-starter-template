{
  "name": "nuxt5-boilerplate",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "postinstall": "nuxt prepare",
    "typecheck": "npx nuxi typecheck .",
    "lint": "eslint . --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.11.3",
    "@vueuse/nuxt": "^15.0.0",
    "eslint": "^10.12.0",
    "nuxt": "^4.5.2",
    "nuxt-security": "^2.6.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.8.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.12"
  },
  "lint-staged": {
    "*.{vue,ts,css}": [
      "eslint --fix",
      "npm run typecheck"
    ]
